{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "rootDir": "obs/src",
    "outDir": "obs/dist",
    "sourceMap": false,
    "skipLibCheck": true
  },
  "include": ["obs/src"]
}
