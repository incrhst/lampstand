{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lampstand",
  "version": "0.5.1",
  "identifier": "org.lampstand.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Lampstand",
        "width": 1100,
        "height": 760,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app",
      "appimage",
      "deb",
      "nsis"
    ],
    "category": "Productivity",
    "shortDescription": "Free, open-source church projection",
    "longDescription": "Lampstand runs a whole church service: songs, scripture, PowerPoint decks and video on the projector, with OBS and stage displays. Free and open source.",
    "copyright": "Copyright © Lampstand contributors. GPL-3.0-or-later.",
    "license": "GPL-3.0-or-later",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI5RkNBMjY3MEE0MTdGNkIKUldScmYwRUtaNkw4S1Q5SEJGWk5CTitXek4rSWtpVDB3V25QN0ViMHl1UlErd1phRVd2T3cwUWQK",
      "endpoints": [
        "https://github.com/incrhst/lampstand/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
